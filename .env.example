# Copy to .env on the host and fill in real values. Never commit .env.

# Flask session signing (required)
SECRET_KEY=replace-with-a-long-random-string

# SQL Server container (required for compose db service)
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=Replace_With_Strong_Passw0rd!

# App SQL login (dsa_app → DSA_Student_Success). Required for Phase A+ routing.
MSSQL_HOST=db
MSSQL_PORT=1433
MSSQL_DATABASE=DSA_Student_Success
MSSQL_USER=dsa_app
MSSQL_PASSWORD=replace-with-dsa-app-password

# Keep seed_data dashboards until Phase D migrates reads (1=yes, 0=SQL-only later).
USE_SEED_DATA=1
